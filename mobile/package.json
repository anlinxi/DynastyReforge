{
  "name": "youcheng-mobile",
  "private": true,
  "version": "1.4.3",
  "description": "幽城复刻手机版：Capacitor 把 game/dist 装进 iOS / 安卓原生壳（PLAT-01，自用，素材打进安装包）。先在 game/ 下 npm run build，再 npm run sync（或 sync:ios / sync:android）；手机固定原版画质，复制后删掉 AI 高清图 assets-hd（capacitor:copy:after）。安卓 apk：npm run apk",
  "scripts": {
    "sync": "cap sync",
    "sync:ios": "cap sync ios",
    "sync:android": "cap sync android",
    "open": "cap open ios",
    "apk": "cd android && ./gradlew assembleRelease",
    "capacitor:copy:after": "sh scripts/strip-public.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
